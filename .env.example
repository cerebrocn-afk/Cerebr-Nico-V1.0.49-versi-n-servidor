# CerebroNico IDE v1.53.1 — Variables de entorno
# Copia a .env y rellena los valores que necesites.

# Puente PC (:5000)
CN_BRIDGE_TOKEN=
CN_BRIDGE_PORT=5000
CN_PROJECT_DIR=.

# Creador web (:5102)
CN_CREADOR_PORT=5102
CN_CREADOR_ROOT=.
CN_CREADOR_TOKEN=

# Memoria hindsight (:5100)
CN_HINDSIGHT_PORT=5100
CN_HINDSIGHT_TOKEN=
CN_MEMORY_PORT=5100

# Hindsight hibrido (SDK local/nube :5101)
HINDSITE_API_URL=http://127.0.0.1:5101
HINDSITE_BANK_ID=
CN_HINDSITE_TOKEN=
CN_HINDSITE_MAX_UNITS=200

# Sandbox (:3500)
CN_SANDBOX_PORT=3500

# Quirofano (puerto interno)
CN_QUIROFANO_PORT=5104

# Nube (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434

# ── Skills MCP con OAuth ────────────────────────────────────────────
# Ver ACTIVAR-SKILLS-OAUTH.md para instrucciones completas.

# Context7 (opcional — rate limits más altos sin ella funciona)
CONTEXT7_API_KEY=

# Unblocked (alternativa a OAuth — Personal/Team API Token)
# OAuth se completa en el navegador la primera vez; esto es para servidores sin GUI
UNBLOCKED_API_TOKEN=

# Webflow (alternativa a OAuth — solo Data API, no Designer API)
# OAuth se completa en el navegador la primera vez
WEBFLOW_API_KEY=

# Servidor web & proveedores IA en la nube
PORT=3000
HOST=0.0.0.0
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
POLLINATIONS_API_KEY=
OLLAMA_URL=

