{
  "name": "cerebronico-ide",
  "private": true,
  "version": "1.0.41",
  "description": "CerebroNico IDE — entorno de desarrollo con IA local (Ollama), sandbox en vivo, puente PC, soporte OpenAI/Gemini/OpenRouter y extensión .cn para archivos personalizados. Por Mario Nicolas Quintero.",
  "type": "module",
  "main": "electron-main.cjs",
  "author": "Mario Nicolas Quintero",
  "copyright": "Copyright © 2026 Mario Nicolas Quintero. Todos los derechos reservados.",
  "scripts": {
    "dev": "tsx server.ts",
    "predev:sin-vite": "node scripts/limpiar-cache-vite.mjs && node scripts/gen-reflejo.mjs && tsx scripts/gen-modelfile.ts && vite build",
    "dev:sin-vite": "cross-env NODE_ENV=production tsx server.ts",
    "skills:proponer-orden": "node scripts/propuesta-orden-skills.mjs",
    "lock:candado": "node scripts/candado-lockfile.mjs",
    "lock:candado:aplicar": "node scripts/candado-lockfile.mjs --aplicar",
    "skills:auditar": "node scripts/auditar-skills.mjs",
    "deriva": "node scripts/deriva-documental.mjs",
    "deriva:fijar": "node scripts/deriva-documental.mjs --fijar",
    "arranque:diagnostico": "node scripts/arranque-diagnostico.mjs",
    "sonda": "node scripts/sonda-arranque.mjs",
    "dev:isolated": "cross-env NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --metafile=dist/server.meta.json --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "start:isolated": "cross-env NODE_ENV=production node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "validar": "node scripts/validar.mjs",
    "validar:estres": "node scripts/validar-estres-bucle.mjs",
    "verificar": "node scripts/quirofano-cli.mjs verificar",
    "cirugia": "node scripts/quirofano-cli.mjs corregir",
    "revertir": "node scripts/quirofano-cli.mjs revertir",
    "snapshot": "node scripts/quirofano-cli.mjs iniciar",
    "manifiesto": "node scripts/manifiesto.mjs",
    "manifiesto:verificar": "node scripts/manifiesto.mjs --verificar",
    "superficie": "node scripts/superficie.mjs",
    "superficie:verificar": "node scripts/superficie.mjs --verificar",
    "sin-claves": "node scripts/sin-claves.mjs",
    "entregar": "tsx scripts/entregar.ts",
    "entregar:verificar": "tsx scripts/entregar-verificar.ts",
    "test:e2e": "python3 tests/comprehensive_e2e_test.py",
    "test:mcp": "python3 tests/mcp_puente_test.py",
    "test:exe": "python3 tests/exe_orquestacion_test.py",
    "test:autonomia": "python3 tests/autonomia_test.py",
    "test:puente": "python3 tests/puente_autocura_test.py",
    "vendor:3d": "node scripts/preparar-vendor-3d.mjs",
    "vendor:3d:verificar": "node scripts/preparar-vendor-3d.mjs --verificar",
    "autonomia": "python autonomia.py estado",
    "autonomia:puertos": "python autonomia.py puertos",
    "autonomia:sanear": "python autonomia.py puertos --matar",
    "autonomia:deps": "python autonomia.py deps --auto",
    "vigilar": "python scripts/vigilante_autonomo.py",
    "vigilar:estado": "python scripts/vigilante_autonomo.py --estado --json",
    "analizar:autonomia": "python scripts/analizar_autonomia.py",
    "dist": "node scripts/sin-claves.mjs && node scripts/verificar-artefactos.mjs && electron-builder --win --x64",
    "runtime:python": "node scripts/preparar-python-embed.mjs",
    "prepack:win": "node scripts/sin-claves.mjs && node scripts/preparar-python-embed.mjs && npm run build && node scripts/verificar-artefactos.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "modelos": "node scripts/instalar-modelos.mjs",
    "modelfiles": "tsx scripts/gen-modelfile.ts",
    "reflejo": "node scripts/gen-reflejo.mjs",
    "memoria": "python scripts/hindsight_daemon.py",
    "memoria:linux": "python3 scripts/hindsight_daemon.py",
    "memoria:estado": "python scripts/hindsight_daemon.py --tools",
    "hindsight:server": "python -m hindsight --llm-provider %HINDSITE_LLM_PROVIDER% --llm-model %HINDSITE_LLM_MODEL%",
    "hindsight:server:linux": "python3 -m hindsight --llm-provider ${HINDSITE_LLM_PROVIDER:-groq} --llm-model ${HINDSITE_LLM_MODEL:-openai/gpt-oss-120b}",
    "memoria:node": "node scripts/hindsight_agent_server.mjs",
    "vendor:sdk": "npm --prefix vendor/hindsight-agent-sdk install --omit=dev",
    "test:hindsight": "tsx tests/hindsightHibrido.test.ts",
    "creador": "python scripts/creador_daemon.py",
    "creador:linux": "python3 scripts/creador_daemon.py",
    "creador:estado": "python scripts/creador_daemon.py --tools",
    "test:creador": "tsx tests/creadorWeb.test.ts",
    "skills": "node scripts/activar-skills.mjs",
    "skills:estado": "node scripts/activar-skills.mjs --estado",
    "skills:context7": "node scripts/activar-skills.mjs --context7",
    "skills:unblocked": "node scripts/activar-skills.mjs --unblocked",
    "skills:webflow": "node scripts/activar-skills.mjs --webflow",
    "skills:todas": "node scripts/activar-skills.mjs --todas",
    "skills:reset-oauth": "node scripts/activar-skills.mjs --reset-oauth",
    "limpiar-raiz": "tsx scripts/limpiar-raiz.mjs",
    "cerebro:server": "python scripts/cerebro_motor.py",
    "cerebro:server:linux": "python3 scripts/cerebro_motor.py",
    "cerebro:estado": "python scripts/cerebro_motor.py --estado",
    "memoria:completa": "python scripts/cerebro_motor.py --port=3500 & python scripts/hindsight_daemon.py --port=3500"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/prismjs": "^1.26.6",
    "@vectorize-io/hindsight-agent-sdk": "file:vendor/hindsight-agent-sdk",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.7.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "build": {
    "appId": "com.cerebronico.ide",
    "productName": "CerebróNico",
    "copyright": "Copyright © 2026 Mario Nicolas Quintero",
    "directories": {
      "output": "dist_electron"
    },
    "asar": false,
    "win": {
      "icon": "dist/favicon.ico"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/*.meta.json",
      "electron-main.cjs",
      "preload.cjs",
      "package.json",
      "node_modules/**/*",
      "agent_bridge_5000.py",
      "requirements.txt",
      "autonomia.py",
      "scripts/**/*",
      "runtime/**/*",
      "tools.config.json",
      "puente-permitidos.json",
      "mcp_servers.json",
      "metadata.json",
      "contrato-rutas.json",
      "perfeccion.json",
      "tsconfig.json",
      "vite.config.ts",
      "index.html",
      "public/**/*",
      "manual-motor/**/*",
      "espejos_servidor/**/*",
      "models/**/*",
      "extensions/**/*",
      "core-agent/**/*",
      "vendor/**/*",
      "ejemplos/**/*",
      "tools/**/*",
      "docs/**/*",
      "skills/**/*",
      "prompts/**/*",
      "cerebro.md",
      "memoria.md",
      "SKILLS.md",
      "RUTAS-DEL-SISTEMA.md",
      "LEEME-PRIMERO.txt",
      "LEEME-EMPAQUETADO.md",
      "GUIA-INSTALADOR-EXE-Y-APK.md",
      "CHANGELOG.md"
    ]
  }
}
