{
  "manual": "motor-cerebronico",
  "version": 2,
  "motor": "v1.98.x",
  "total_herramientas": 103,
  "proposito": "Que cualquier modelo opere el motor. Lectura por maquina.",
  "canales": {
    "nativo": "Usa el protocolo tool_calls si lo tienes.",
    "texto": "Si no, emite la llamada como texto; el motor la detecta."
  },
  "rutas_de_trabajo": {
    "raiz_datos": "PROJECT_DIR si existe; si no, <instalacion>/.proyectos",
    "proyecto": "<raiz_datos>/<nombre-del-proyecto>/  (hija directa, una por proyecto)",
    "estado_migrable": "<raiz_datos>/.cerebro-db/ y <raiz_datos>/.cerebronico/",
    "conciencia": "<raiz_datos>/cerebro/  (indice.json + notas .md por tema)",
    "creador": "<raiz_datos>/.creador/  (sitios + exportaciones)",
    "papelera": "<raiz_datos>/.cerebro-papelera/",
    "instalacion": "<instalacion>/app/  (src, server, dist, runtime, scripts, manual-motor, docs)",
    "variables": {
      "PROJECT_DIR": "raiz de datos del motor (Node/TS)",
      "CN_PROJECT_DIR": "la MISMA raiz para el puente Python :5000 — si no coincide, el almacenamiento se parte en dos",
      "CN_CREADOR_ROOT": "donde guarda sus sitios el creador web :5102",
      "CN_HINDSITE_MIRROR": "archivo del espejo de memoria :5100",
      "CN_BOVEDA_RAIZ": "boveda de claves (C:\\CN en Windows, ~/CN en el resto)",
      "CN_EMBED_MODEL": "modelo de embeddings (por defecto snowflake-arctic-embed:33m)"
    },
    "regla": "Rutas RELATIVAS a la raiz del proyecto. Nunca absolutas de Windows."
  },
  "puertos": {
    "3000": "IDE (editor + chat + planificador)",
    "3500": "sandbox / previsualizador",
    "5000": "puente PC (pack pc)",
    "5100": "memoria / cerebro (hindsight)",
    "5102": "creador web",
    "11434": "Ollama local"
  },
  "formatos_texto": [
    {
      "id": "valla-nombre-json",
      "ejemplo": "```cerebronico:write_file\\n{\"path\":\"a.html\",\"content\":\"...\"}\\n```"
    },
    {
      "id": "valla-con-ruta",
      "ejemplo": "```html file=\"index.html\"\\n<!doctype html>...\\n```"
    },
    {
      "id": "valla-ruta-sola",
      "ejemplo": "```index.html\\n...\\n```"
    },
    {
      "id": "valla-dos-puntos",
      "ejemplo": "```ts:src/app.ts\\n...\\n```"
    },
    {
      "id": "nombre-mas-json",
      "ejemplo": "read_file\\n{\"path\":\"index.html\"}"
    },
    {
      "id": "pseudo-xml",
      "ejemplo": "<dots_function_call><write_file>{...}</write_file></dots_function_call>"
    }
  ],
  "contrato_turno_v1_69": {
    "que_es": "set_plan escribe las etapas en la pestana Planificador (primer plano, local y nube) y abre un contrato de aceptacion.",
    "reglas": [
      "El turno NO cierra con etapas sin tachar: el motor se auto-pregunta (inyecta la lista [x]/[ ]/[>]) y exige seguir en el mismo hilo.",
      "Tope 3 exigencias; agotado, el cierre es PARCIAL y lista las etapas que faltan (nunca 'Hecho' con el plan abierto).",
      "Tachar = update_task {task_id, status: completed, evidencia}. Sin evidencia queda cerrada_sin_verificar (puerta roja).",
      "failed con causa tambien cierra la etapa: es la forma honesta de abandonar.",
      "El plan sobrevive entre turnos (30 min): 'segui' retoma donde quedo; otro pedido se reemplaza con set_plan nuevo."
    ]
  },
