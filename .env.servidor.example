# CerebróNico servidor v1.0.55 — plantilla sin secretos
# NO subir el .env completado al repositorio.
CN_SERVER_MODE=1
NODE_ENV=production
# Secreto propio de al menos 24 caracteres; obligatorio.
ACCESS_TOKEN=
# Obligatorio: origen HTTPS REAL de la IDE, sin barra final. No hay dominio inventado.
CN_PUBLIC_ORIGIN=
# Carpeta separada del código. Para probar en sandbox:
PROJECT_DIR=./workspace
# En publicación: reemplazar por carpeta del volumen durable montado.
# CN_PROJECT_DIR=. NO sustituye PROJECT_DIR.
HOST=0.0.0.0
# Conserva el PORT que asigne el alojamiento. 3000 es sólo ejemplo de sandbox.
PORT=3000
# Para publicación Cloud Run, usar CN_DEPLOY_TARGET=cloudrun.
# K_SERVICE también identifica Cloud Run automáticamente.
CN_DEPLOY_TARGET=
SANDBOX_PORT=3500
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
CN_COOKIE_SECURE=1
