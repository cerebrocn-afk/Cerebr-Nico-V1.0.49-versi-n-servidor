# Edición servidor — NO subir .env con claves reales
CN_SERVER_MODE=1
NODE_ENV=production
# Completar con secreto propio >=24 caracteres
ACCESS_TOKEN=
CN_PUBLIC_ORIGIN=https://ide.example.com
# Debe estar en un volumen durable. ./workspace sirve para la prueba local;
# en Cloud Run configura la carpeta del volumen montado, no el disco efímero.
PROJECT_DIR=./workspace
HOST=127.0.0.1
PORT=3000
SANDBOX_PORT=3500
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
CN_COOKIE_SECURE=1
