-export const KB_PODER_X50 = [
-    // ---------- PYTHON ----------
-    { id: "x50-py-venv", table: "tool", title: "Python: entornos virtuales", weight: 0.7, keys: ["python", "venv", "virtualenv", "pip", "aislar", "dependencias"], body: "Usa `python -m venv .venv` y actívalo con `source .venv/bin/activate`. Aísla las dependencias por carpeta para no contaminar el sistema. Congela con `pip freeze > requirements.txt`." },
-    { id: "x50-py-fstring", table: "syntax", title: "Python: f-strings", weight: 0.6, keys: ["python", "fstring", "formato", "interpolacion", "cadena"], body: "`f\"{nombre=}\"` imprime nombre y valor (debug, 3.8+). Formatea con `f\"{x:.2f}\"` o `f\"{n:,}\"`. Más rápido y legible que `%` o `.format()`." },
-    { id: "x50-py-comprehension", table: "pattern", title: "Python: comprehensions", weight: 0.6, keys: ["python", "comprehension", "lista", "diccionario", "generador"], body: "`[x*x for x in rango if x%2==0]` crea listas de forma declarativa. Hay versión de dict `{k:v for ...}` y set. Para flujos grandes usa paréntesis (generador) y no cargues todo en memoria." },
-    { id: "x50-py-type-hints", table: "skill", title: "Python: anotaciones de tipo", weight: 0.7, keys: ["python", "typing", "anotaciones", "mypy", "tipos"], body: "Anota con `def f(x: int) -> str:` y comprueba con `mypy` o `pyright`. Usa `list[int]`, `dict[str,int]`, `Optional[T]` y `|` (3.10+). No cambian la ejecución, documentan y atrapan fallos pronto." },
-    { id: "x50-py-pathlib", table: "tool", title: "Python: pathlib", weight: 0.6, keys: ["python", "pathlib", "ruta", "fichero", "os.path"], body: "`from pathlib import Path`: `Path('x')/'y'` une rutas sin barras a mano, `.read_text()`, `.glob('*.txt')`, `.exists()`. Más claro y portátil que concatenar cadenas." },
-    { id: "x50-py-dataclass", table: "pattern", title: "Python: dataclasses", weight: 0.6, keys: ["python", "dataclass", "clase", "inmutable", "frozen"], body: "`@dataclass` genera `__init__`, `__repr__` y `__eq__`. Con `frozen=True` quedan inmutables (hashables). Usa `field(default_factory=list)` para mutables; nunca pongas `[]` como valor por defecto." },
-    { id: "x50-py-context", table: "pattern", title: "Python: context managers", weight: 0.6, keys: ["python", "with", "contextmanager", "recurso", "cerrar"], body: "`with open(f) as fh:` cierra el recurso aunque salte una excepción. Crea los tuyos con `@contextmanager` y un `yield`, o implementando `__enter__`/`__exit__`." },
-    { id: "x50-py-asyncio", table: "skill", title: "Python: asyncio básico", weight: 0.7, keys: ["python", "asyncio", "async", "await", "concurrencia"], body: "`async def` + `await` para E/S concurrente en un solo hilo. `asyncio.gather(*tareas)` corre en paralelo lógico. No bloquees con `time.sleep`; usa `await asyncio.sleep`. No acelera cálculo puro (usa procesos para eso)." },
-    { id: "x50-py-gil", table: "lesson", title: "Python: el GIL y el paralelismo", weight: 0.6, keys: ["python", "gil", "hilos", "multiprocessing", "paralelo"], body: "El GIL impide que dos hilos ejecuten bytecode a la vez: los hilos sirven para E/S, no para cálculo. Para CPU usa `multiprocessing` o `concurrent.futures.ProcessPoolExecutor`." },
-    { id: "x50-py-pytest", table: "tool", title: "Python: pytest", weight: 0.7, keys: ["python", "pytest", "prueba", "fixture", "assert"], body: "`pytest` descubre `test_*.py` y usa `assert` normal. Comparte montaje con `@pytest.fixture`, parametriza con `@pytest.mark.parametrize`. Mide cobertura con `pytest --cov`." },
-    { id: "x50-py-logging", table: "skill", title: "Python: logging en vez de print", weight: 0.6, keys: ["python", "logging", "logger", "nivel", "traza"], body: "Usa `logging.getLogger(__name__)` con niveles (DEBUG/INFO/WARNING/ERROR). Configura una vez en el arranque. A diferencia de print, se filtra por nivel, lleva marca de tiempo y se desvía a fichero." },
-    { id: "x50-py-exc-chain", table: "pattern", title: "Python: excepciones encadenadas", weight: 0.6, keys: ["python", "excepcion", "raise", "from", "captura"], body: "Captura concreto, no `except:` desnudo. Reeleva con `raise X from e` para conservar la causa. No silencies con `except: pass`; al menos registra. `finally` para limpieza garantizada." },
-    // ---------- GO ----------
-    { id: "x50-go-modules", table: "tool", title: "Go: módulos", weight: 0.7, keys: ["golang", "gomod", "gosum", "paquetes", "dependencia"], body: "`go mod init ejemplo.com/app` crea go.mod. `go get`, `go mod tidy` limpia lo no usado. Las versiones quedan fijadas en go.sum. GOPATH ya no hace falta para proyectos con módulos." },
-    { id: "x50-go-goroutine", table: "skill", title: "Go: goroutines y channels", weight: 0.7, keys: ["golang", "goroutine", "channel", "concurrencia", "select"], body: "`go f()` lanza una goroutine ligera. Comunícate con canales `ch := make(chan int)`; `select` espera varios. Lema: no compartas memoria para comunicar, comunícate para compartir memoria." },
-    { id: "x50-go-defer", table: "pattern", title: "Go: defer para limpieza", weight: 0.6, keys: ["golang", "defer", "cerrar", "recurso", "limpieza"], body: "`defer f.Close()` ejecuta al salir de la función, aunque haya return temprano o panic. Los defers se apilan (LIFO). Ideal para cerrar ficheros, liberar mutex o medir tiempos." },
-    { id: "x50-go-errwrap", table: "pattern", title: "Go: errores explícitos", weight: 0.65, keys: ["golang", "errors", "errwrap", "errorf", "errorsis"], body: "Go devuelve el fallo como valor: `if err != nil { return fmt.Errorf(\"contexto: %w\", err) }`. Envuelve con `%w` y comprueba con `errors.Is`/`errors.As`. No hay excepciones." },
-    { id: "x50-go-interface", table: "lesson", title: "Go: interfaces implícitas", weight: 0.6, keys: ["golang", "interface", "implicito", "duck", "contrato"], body: "Un tipo satisface una interfaz solo con tener sus métodos; no se declara `implements`. Define interfaces pequeñas donde se consumen, no donde se producen. `io.Reader`/`io.Writer` son el modelo a imitar." },
-    { id: "x50-go-slices", table: "lesson", title: "Go: slices y su respaldo", weight: 0.6, keys: ["golang", "slice", "append", "capacidad", "arreglo"], body: "Un slice apunta a un arreglo de respaldo con largo y capacidad. `append` puede reasignar y copiar. Cuidado: dos slices del mismo arreglo comparten memoria; usa `copy` o `s[i:j:j]` para aislar." },
-    { id: "x50-go-context", table: "skill", title: "Go: context para cancelar", weight: 0.65, keys: ["golang", "context", "cancelar", "timeout", "deadline"], body: "Pasa `ctx context.Context` como primer parámetro. `context.WithTimeout` propaga cancelación a goroutines y llamadas. Comprueba `ctx.Done()` o `ctx.Err()` para abortar trabajo a tiempo." },
-    { id: "x50-go-testing", table: "tool", title: "Go: pruebas de tabla", weight: 0.65, keys: ["golang", "gotest", "tabla", "benchmark", "subtest"], body: "`go test ./...` corre `TestXxx(t *testing.T)`. Usa casos en tabla con `t.Run(nombre, ...)` para subpruebas aisladas. Mide con `func BenchmarkX(b *testing.B)` y `go test -bench`." },
-    { id: "x50-go-race", table: "tool", title: "Go: detector de carreras", weight: 0.6, keys: ["golang", "race", "detector", "datos", "mutex"], body: "`go test -race` y `go run -race` instrumentan el binario para cazar accesos concurrentes sin sincronizar. Úsalo en CI: una carrera de datos es un fallo real aunque hoy no estalle." },
-    // ---------- RUST ----------
-    { id: "x50-rs-ownership", table: "lesson", title: "Rust: ownership", weight: 0.7, keys: ["rust", "ownership", "propiedad", "move", "drop"], body: "Cada valor tiene un dueño; al salir de alcance se libera (drop). Asignar o pasar por valor mueve la propiedad y el origen deja de ser válido. Así no hay doble liberación ni fugas sin recolector." },
-    { id: "x50-rs-borrow", table: "lesson", title: "Rust: borrowing y referencias", weight: 0.7, keys: ["rust", "borrow", "referencia", "mutable", "prestamo"], body: "Puedes tener muchas referencias `&T` inmutables O una sola `&mut T`, nunca ambas a la vez. El verificador lo garantiza en compilación: carreras de datos imposibles en código seguro." },
-    { id: "x50-rs-result", table: "pattern", title: "Rust: Result y el operador ?", weight: 0.65, keys: ["rust", "result", "option", "unwrap", "interrogacion"], body: "Devuelve `Result<T, E>` y propaga fallos con `?`. Evita `.unwrap()` en producción (entra en panic). Para ausencia usa `Option<T>` y `match` o `if let Some(x)`." },
-    { id: "x50-rs-lifetime", table: "lesson", title: "Rust: lifetimes", weight: 0.6, keys: ["rust", "lifetime", "anotacion", "referencia", "alcance"], body: "Las anotaciones `'a` dicen al compilador cuánto viven las referencias para que ninguna sobreviva al dato que apunta. Casi siempre se infieren; se escriben cuando una función devuelve una referencia." },
-    { id: "x50-rs-cargo", table: "tool", title: "Rust: cargo", weight: 0.65, keys: ["rust", "cargo", "crate", "build", "clippy"], body: "`cargo build/run/test` compila con Cargo.toml. `cargo clippy` da avisos finos y `cargo fmt` formatea. Las dependencias (crates) viven en crates.io y quedan fijadas en Cargo.lock." },
-    { id: "x50-rs-enum", table: "pattern", title: "Rust: enums y match", weight: 0.6, keys: ["rust", "enum", "match", "variante", "patron"], body: "Los enums llevan datos por variante y `match` obliga a cubrir todos los casos (exhaustivo). Es la base de Option/Result y de máquinas de estado seguras." },
-    // ---------- SQL ----------
-    { id: "x50-sql-join", table: "skill", title: "SQL: tipos de JOIN", weight: 0.7, keys: ["sql", "join", "inner", "leftjoin", "relacion"], body: "INNER JOIN cruza solo coincidencias; LEFT JOIN conserva toda la tabla izquierda (NULL donde no haya pareja). Une siempre por claves indexadas y nombra el criterio en ON, no en WHERE para los externos." },
-    { id: "x50-sql-index", table: "skill", title: "SQL: índices", weight: 0.7, keys: ["sql", "indice", "index", "consulta", "rendimiento"], body: "Un índice acelera búsquedas y JOINs a costa de escrituras y espacio. Indexa columnas de filtro y de unión. Un índice compuesto sirve de izquierda a derecha; cuida el orden de las columnas." },
-    { id: "x50-sql-tx", table: "rule", title: "SQL: transacciones ACID", weight: 0.8, keys: ["sql", "transaccion", "acid", "commit", "rollback"], body: "Envuelve cambios relacionados en BEGIN ... COMMIT; ante un fallo haz ROLLBACK. ACID garantiza atomicidad y consistencia. Mantén las transacciones cortas para no bloquear filas de más." },
-    { id: "x50-sql-nmas1", table: "error", title: "SQL: problema N+1", weight: 0.75, keys: ["sql", "nmas1", "consultas", "orm", "lazy"], body: "Cargar una lista y luego una consulta por cada elemento (N+1) mata el rendimiento. Síntoma típico de un ORM con carga perezosa. Solución: carga ansiosa (eager/JOIN) o un IN con todos los ids." },
-    { id: "x50-sql-inject", table: "rule", title: "SQL: nunca concatenes consultas", weight: 0.85, keys: ["sql", "inyeccion", "parametrizada", "prepared", "seguridad"], body: "Jamás metas datos del usuario con formato de cadena en una consulta: eso es inyección SQL. Usa siempre consultas parametrizadas / prepared statements; el motor separa código de datos por ti." },
-    // ---------- DOCKER ----------
-    { id: "x50-dk-layers", table: "lesson", title: "Docker: capas y caché", weight: 0.65, keys: ["docker", "dockerfile", "capas", "cache", "imagen"], body: "Cada instrucción del Dockerfile es una capa cacheada. Copia primero el manifiesto de dependencias e instala, y COPIA el código después: así un cambio de código no reinstala todo. Ordena de lo estable a lo cambiante." },
-    { id: "x50-dk-multistage", table: "pattern", title: "Docker: multi-stage build", weight: 0.7, keys: ["docker", "multistage", "build", "ligera", "compilar"], body: "Compila en una etapa pesada y copia solo el binario/artefacto a una etapa final mínima (`FROM ... AS build` + `COPY --from=build`). La imagen entregada queda pequeña y sin herramientas de compilación." },
-    { id: "x50-dk-volume", table: "skill", title: "Docker: volúmenes vs bind mounts", weight: 0.6, keys: ["docker", "volumen", "bind", "persistencia", "montaje"], body: "Un volumen gestionado por Docker persiste datos entre contenedores; un bind mount expone una carpeta del host (bueno para desarrollo). El sistema de ficheros del contenedor es efímero: lo no montado se pierde al recrear." },
-    { id: "x50-dk-compose", table: "tool", title: "Docker Compose", weight: 0.65, keys: ["docker", "compose", "servicios", "yaml", "redes"], body: "`docker compose up` levanta varios servicios definidos en compose.yaml con su red interna y nombres DNS por servicio. Ideal para un stack local (app + db + caché). `down -v` también borra volúmenes." },
-    { id: "x50-dk-nonroot", table: "rule", title: "Docker: no corras como root", weight: 0.8, keys: ["docker", "noroot", "root", "seguridad", "privilegios"], body: "Añade `USER app` tras crear un usuario sin privilegios: si el contenedor se compromete, el atacante no es root. Expone solo lo necesario y no metas secretos en la imagen (usa variables o secretos en ejecución)." },
-    { id: "x50-dk-dockerignore", table: "skill", title: "Docker: .dockerignore", weight: 0.6, keys: ["docker", "dockerignore", "contexto", "build", "excluir"], body: "Excluye del contexto de build lo que no viaja (node_modules, .git, artefactos). Acelera el build, reduce la imagen y evita filtrar ficheros sensibles por error." },
-    // ---------- GIT ----------
-    { id: "x50-git-rebase", table: "skill", title: "Git: rebase vs merge", weight: 0.65, keys: ["git", "rebase", "merge", "historial", "rama"], body: "Merge conserva la historia real con un commit de unión; rebase reescribe para una línea limpia. No reescribas (rebase) lo ya publicado y compartido: cambia los hashes y rompe a quien ya lo tiene." },
-    { id: "x50-git-reset", table: "lesson", title: "Git: reset soft/mixed/hard", weight: 0.6, keys: ["git", "reset", "soft", "hard", "deshacer"], body: "`--soft` mueve la rama y deja los cambios en el índice; `--mixed` (por defecto) los deja en el árbol; `--hard` los descarta. Hard es destructivo: conócelo bien antes de usarlo." },
-    { id: "x50-git-stash", table: "tool", title: "Git: stash", weight: 0.55, keys: ["git", "stash", "guardar", "temporal", "cambiar"], body: "`git stash` aparca cambios sin confirmar para cambiar de rama limpio; `git stash pop` los recupera. Usa `stash -u` para incluir ficheros nuevos. Es una pila: nombra con `stash push -m`." },
-    { id: "x50-git-bisect", table: "tool", title: "Git: bisect para cazar regresiones", weight: 0.6, keys: ["git", "bisect", "regresion", "binaria", "culpable"], body: "`git bisect start/bad/good` hace búsqueda binaria entre commits para hallar el que introdujo un fallo. Con `git bisect run script` lo automatiza. Convierte horas de búsqueda en logaritmo." },
-    { id: "x50-git-cherry", table: "skill", title: "Git: cherry-pick", weight: 0.55, keys: ["git", "cherrypick", "commit", "portar", "seleccionar"], body: "`git cherry-pick <hash>` aplica un commit concreto a la rama actual. Útil para llevar un arreglo puntual a una rama de mantenimiento sin traer todo lo demás." },
-    // ---------- HTTP / WEB ----------
-    { id: "x50-http-metodos", table: "skill", title: "HTTP: métodos y su semántica", weight: 0.65, keys: ["http", "get", "post", "idempotente", "verbo"], body: "GET lee y no muta (cacheable); POST crea; PUT reemplaza (idempotente); PATCH modifica parcial; DELETE borra. Respetar la semántica permite cachés, reintentos seguros y proxies correctos." },
-    { id: "x50-http-status", table: "lesson", title: "HTTP: códigos de estado", weight: 0.6, keys: ["http", "status", "codigo", "redireccion", "404"], body: "2xx éxito, 3xx redirección, 4xx culpa del cliente (400 mal formado, 401 sin credencial, 403 prohibido, 404 no existe), 5xx culpa del servidor. Devuelve el código correcto, no 200 con un fallo dentro." },
-    { id: "x50-http-cors", table: "error", title: "HTTP: CORS bloqueado", weight: 0.75, keys: ["http", "cors", "origen", "preflight", "navegacion"], body: "El navegador bloquea llamadas entre orígenes distintos salvo que el servidor envíe cabeceras Access-Control-Allow-*. Es una protección del lado cliente: se arregla en el servidor, no silenciándola en el cliente." },
-    { id: "x50-http-cache", table: "skill", title: "HTTP: cabeceras de caché", weight: 0.6, keys: ["http", "cache", "etag", "cachecontrol", "maxage"], body: "`Cache-Control: max-age` fija cuánto vale una respuesta; `ETag` permite revalidar con 304 sin reenviar cuerpo. Para estáticos con hash en el nombre usa `immutable`; para datos vivos, `no-cache`." },
-    { id: "x50-http-rest", table: "pattern", title: "REST: diseño de recursos", weight: 0.6, keys: ["http", "rest", "recurso", "api", "endpoint"], body: "Modela recursos como sustantivos en plural (`/facturas/42`) y usa los verbos HTTP para la acción, no en la ruta. Versiona la API y pagina las colecciones. Devuelve enlaces o ids, no estados internos." },
-    { id: "x50-http-timeout", table: "rule", title: "HTTP: timeouts y reintentos", weight: 0.75, keys: ["http", "timeout", "reintento", "backoff", "cliente"], body: "Toda llamada de red necesita un timeout: sin él, un cuelgue remoto cuelga tu proceso. Reintenta solo operaciones idempotentes y con retroceso exponencial más algo de azar (jitter) para no sincronizar la estampida." },
-    // ---------- SEGURIDAD ----------
-    { id: "x50-sec-hash", table: "rule", title: "Seguridad: hashea contraseñas", weight: 0.85, keys: ["seguridad", "hash", "bcrypt", "argon2", "contrasena"], body: "Nunca guardes contraseñas en claro ni con MD5/SHA simple. Usa un hash lento con sal: bcrypt, scrypt o argon2id. La lentitud es la defensa: encarece el ataque por fuerza bruta." },
-    { id: "x50-sec-jwt", table: "lesson", title: "Seguridad: JWT, qué son y qué no", weight: 0.7, keys: ["seguridad", "jwt", "firma", "sesion", "caducidad"], body: "Un JWT va firmado, no cifrado: cualquiera lee su contenido, así que no metas secretos dentro. Verifica siempre la firma y el algoritmo esperado, pon caducidad corta y ten forma de revocar." },
-    { id: "x50-sec-xss", table: "rule", title: "Seguridad: XSS", weight: 0.85, keys: ["seguridad", "xss", "escapar", "inyeccion", "html"], body: "Nunca inyectes texto del usuario como HTML sin escapar: puede ejecutar scripts en el navegador de otros. Escapa al renderizar, usa plantillas que escapan por defecto y una Content-Security-Policy estricta." },
-    { id: "x50-sec-secrets", table: "rule", title: "Seguridad: fuera secretos del código", weight: 0.85, keys: ["seguridad", "secretos", "credenciales", "entorno", "dotenv"], body: "Claves y credenciales van en variables de entorno o un gestor de secretos, nunca en el repositorio. Si una clave se filtra al historial, rotárala; borrarla del commit no basta." },
-    { id: "x50-sec-privilegio", table: "lesson", title: "Seguridad: mínimo privilegio", weight: 0.7, keys: ["seguridad", "privilegio", "minimo", "autorizacion", "alcance"], body: "Da a cada componente solo los permisos que necesita, ni uno más. Tokens de alcance acotado, cuentas de servicio dedicadas y nada de credenciales de administrador para tareas rutinarias." },
-    // ---------- TESTING ----------
-    { id: "x50-test-piramide", table: "lesson", title: "Testing: la pirámide", weight: 0.65, keys: ["testing", "piramide", "unitaria", "integracion", "e2e"], body: "Muchas pruebas unitarias (rápidas, aisladas), menos de integración y pocas de extremo a extremo (lentas, frágiles). Invertir la pirámide da suites lentas que la gente deja de correr." },
-    { id: "x50-test-tdd", table: "pattern", title: "Testing: TDD rojo-verde-refactor", weight: 0.6, keys: ["testing", "tdd", "rojo", "verde", "refactor"], body: "Escribe una prueba que falle (rojo), el mínimo código para pasarla (verde) y después limpia (refactor) con la red puesta. Diseña la interfaz desde fuera y evita código que nadie usa." },
-    { id: "x50-test-mock", table: "skill", title: "Testing: mocks y dobles", weight: 0.6, keys: ["testing", "mock", "stub", "doble", "aislamiento"], body: "Sustituye dependencias lentas o externas (red, reloj, disco) por dobles para aislar la unidad. No simules lo que posees si puedes probarlo de verdad barato; demasiados mocks prueban el mock, no el código." },
-    { id: "x50-test-flaky", table: "error", title: "Testing: pruebas flaky", weight: 0.7, keys: ["testing", "flaky", "intermitente", "tiempo", "orden"], body: "Una prueba que a veces pasa y a veces no suele depender del reloj, del orden de ejecución, de datos compartidos o de concurrencia. No la reintentes a ciegas: hazla determinista o te mentirá justo cuando importa." },
-    { id: "x50-test-cobertura", table: "lesson", title: "Testing: cobertura no es calidad", weight: 0.55, keys: ["testing", "cobertura", "metrica", "afirmacion", "calidad"], body: "El % de cobertura dice qué líneas se ejecutan, no si se comprueban. Una prueba sin afirmaciones sube cobertura y no prueba nada. Cubre caminos y casos límite, no un número." },
-    { id: "x50-test-fixture", table: "pattern", title: "Testing: datos y montaje", weight: 0.55, keys: ["testing", "montaje", "semilla", "determinista", "limpieza"], body: "Cada prueba monta su estado y lo limpia; nunca dependas del residuo de otra. Fija semillas de azar y el reloj. Pruebas independientes se pueden correr en cualquier orden y en paralelo." },
-    // ---------- RENDIMIENTO ----------
-    { id: "x50-perf-medir", table: "rule", title: "Rendimiento: mide antes de optimizar", weight: 0.8, keys: ["rendimiento", "perfilado", "profiler", "medir", "cuellobotella"], body: "No optimices por intuición: perfila y ataca el cuello de botella real. La mayoría del tiempo vive en poco código. Optimizar lo que no pesa añade complejidad sin ganancia." },
-    { id: "x50-perf-bigo", table: "lesson", title: "Rendimiento: complejidad asintótica", weight: 0.65, keys: ["rendimiento", "complejidad", "bigo", "escala", "algoritmo"], body: "O(n log n) escala; O(n²) muere con el tamaño. Antes de microoptimizar, elige la estructura y el algoritmo correctos: un diccionario (O(1)) frente a buscar en lista (O(n)) cambia más que cualquier truco." },
-    { id: "x50-perf-cache", table: "pattern", title: "Rendimiento: memoización", weight: 0.6, keys: ["rendimiento", "memoizacion", "cachear", "invalidar", "recomputo"], body: "Guardar el resultado de un cálculo caro evita repetirlo, pero introduce el problema difícil: invalidar cuando los datos cambian. Cachea lo puro y determinista; pon límite de tamaño y expiración." },
-    { id: "x50-perf-nmas1", table: "pattern", title: "Rendimiento: lotes en vez de goteo", weight: 0.6, keys: ["rendimiento", "lote", "batch", "redondeo", "viajes"], body: "Mil llamadas pequeñas a red o disco cuestan más que una que trae todo. Agrupa en lotes, reduce viajes de ida y vuelta y transmite (stream) lo grande en vez de cargarlo entero en memoria." },
-    { id: "x50-perf-memoria", table: "lesson", title: "Rendimiento: memoria y asignaciones", weight: 0.55, keys: ["rendimiento", "memoria", "asignacion", "fuga", "recolector"], body: "Asignar y liberar sin parar presiona al recolector y fragmenta. Reutiliza búferes en bucles calientes, evita copias innecesarias y vigila referencias vivas que impiden liberar (fugas lógicas)." },
-    // ---------- LINUX / CLI ----------
-    { id: "x50-lx-chmod", table: "skill", title: "Linux: permisos y chmod", weight: 0.65, keys: ["linux", "chmod", "octal", "propietario", "rwx"], body: "Los permisos van en tres ternas rwx para dueño, grupo y resto. `chmod 644` es rw-r--r--, `755` añade ejecución. `chmod +x` hace ejecutable un script. `chown` cambia el dueño." },
-    { id: "x50-lx-grep", table: "tool", title: "Linux: grep y ripgrep", weight: 0.6, keys: ["linux", "grep", "ripgrep", "buscar", "regex"], body: "`grep -rn patron carpeta` busca recursivo con número de línea. `rg` (ripgrep) es mucho más rápido y respeta .gitignore. Usa `-i` para ignorar mayúsculas y `-F` para texto literal." },
-    { id: "x50-lx-find", table: "tool", title: "Linux: find", weight: 0.6, keys: ["linux", "find", "buscar", "filtro", "exec"], body: "`find . -name '*.log' -mtime +7 -delete` localiza por nombre/edad y actúa. `find ... -exec cmd {} +` lanza un comando por lote. Para nombres con espacios usa `-print0` con `xargs -0`." },
-    { id: "x50-lx-pipe", table: "pattern", title: "Linux: tuberías y redirección", weight: 0.6, keys: ["linux", "pipe", "tuberia", "redireccion", "stdout"], body: "`a | b` conecta la salida de a con la entrada de b. `>` sobrescribe, `>>` añade, `2>&1` une error con salida estándar. Encadena herramientas pequeñas: la filosofía Unix." },
-    { id: "x50-lx-ps", table: "tool", title: "Linux: procesos y señales", weight: 0.6, keys: ["linux", "proceso", "kill", "senal", "sigterm"], body: "`ps aux` lista procesos; `kill -TERM pid` pide salida limpia, `-KILL` la fuerza. Un proceso bien hecho atrapa SIGTERM para cerrar conexiones y guardar antes de morir. `jobs`/`bg`/`fg` manejan los de la shell." },
-    { id: "x50-lx-systemd", table: "skill", title: "Linux: systemd y journalctl", weight: 0.6, keys: ["linux", "systemd", "servicio", "journalctl", "unit"], body: "`systemctl status/start/enable nombre` gestiona servicios; `enable` los arranca al inicio. Los logs se leen con `journalctl -u nombre -f`. Define unidades en /etc/systemd/system con Restart=on-failure." },
-    { id: "x50-lx-env", table: "lesson", title: "Linux: variables de entorno y PATH", weight: 0.55, keys: ["linux", "entorno", "path", "export", "shell"], body: "`export VAR=valor` lo pasa a los hijos; sin export solo vive en la shell actual. PATH es la lista de carpetas donde se buscan ejecutables, separadas por dos puntos. `which cmd` dice cuál gana." },
-    { id: "x50-lx-tar", table: "tool", title: "Linux: tar y compresión", weight: 0.5, keys: ["linux", "tar", "gzip", "empaquetar", "comprimir"], body: "`tar -czf x.tar.gz carpeta` empaqueta y comprime; `-xzf` extrae. Excluye con `--exclude`. Para ver sin extraer, `tar -tzf`. tar agrupa, gzip/zstd comprimen." },
-    // ---------- BASH ----------
-    { id: "x50-bash-strict", table: "rule", title: "Bash: modo estricto", weight: 0.75, keys: ["bash", "estricto", "euopipefail", "script", "robusto"], body: "Empieza scripts con `set -euo pipefail`: corta al primer fallo, trata variables no definidas como error y propaga fallos dentro de tuberías. Evita que un script siga adelante sobre un paso roto." },
-    { id: "x50-bash-quote", table: "rule", title: "Bash: comilla tus variables", weight: 0.8, keys: ["bash", "comillas", "expansion", "espacios", "inyeccion"], body: "Usa siempre `\"$var\"`: sin comillas, un valor con espacios se parte y uno vacío desaparece. Es también defensa contra inyección por rutas raras. Para arreglos, `\"${arr[@]}\"`." },
-    { id: "x50-bash-subst", table: "skill", title: "Bash: sustituciones útiles", weight: 0.55, keys: ["bash", "sustitucion", "parametro", "defecto", "recorte"], body: "`${v:-def}` da un valor por defecto, `${v:?msg}` aborta si falta, `${v%.*}` recorta la extensión y `${v##*/}` deja el nombre base. Hacen scripts cortos sin llamar a herramientas externas." },
-    // ---------- JAVASCRIPT / TYPESCRIPT ----------
-    { id: "x50-js-eventloop", table: "lesson", title: "JS: el event loop", weight: 0.65, keys: ["javascript", "eventloop", "microtarea", "cola", "asincrono"], body: "JS es monohilo: la pila corre hasta vaciarse y luego atiende microtareas (promesas) antes que macrotareas (timers). Un cálculo largo bloquea todo; trocea o déjalo a un worker." },
-    { id: "x50-js-promise", table: "skill", title: "JS: promesas y async/await", weight: 0.65, keys: ["javascript", "promesa", "async", "await", "paralelo"], body: "`await` espera una promesa; para correr varias a la vez usa `Promise.all([...])`, no awaits en serie dentro de un bucle. Captura con try/catch y recuerda que `Promise.all` falla al primer rechazo." },
-    { id: "x50-js-closure", table: "lesson", title: "JS: closures", weight: 0.6, keys: ["javascript", "closure", "cierre", "alcance", "captura"], body: "Una función recuerda las variables de donde se creó, aunque esa función externa ya haya terminado. Base de callbacks con estado y de la privacidad por ámbito. Ojo con capturar la variable de un bucle (usa let)." },
-    { id: "x50-js-equal", table: "error", title: "JS: == frente a ===", weight: 0.6, keys: ["javascript", "igualdad", "coercion", "estricto", "comparar"], body: "`==` convierte tipos antes de comparar y da sorpresas (`0 == ''` es true). Usa siempre `===`. Para nulos, `x == null` sí es útil: cubre null e indefinido a la vez." },
-    { id: "x50-js-debounce", table: "pattern", title: "JS: debounce y throttle", weight: 0.6, keys: ["javascript", "debounce", "throttle", "eventos", "frecuencia"], body: "Debounce espera a que paren los eventos para actuar una vez (buscador que escribe); throttle limita a una vez cada X (scroll). Ambos evitan trabajo repetido ante eventos muy frecuentes." },
-    { id: "x50-js-immut", table: "pattern", title: "JS: inmutabilidad", weight: 0.55, keys: ["javascript", "inmutable", "copia", "spread", "congelar"], body: "No mutes objetos compartidos: crea copias con `{...obj, k:v}` o `[...arr]`. Facilita comparar por referencia y razonar sobre el estado. `Object.freeze` congela superficialmente (solo el primer nivel)." },
-    { id: "x50-ts-narrow", table: "skill", title: "TypeScript: estrechado de tipos", weight: 0.65, keys: ["typescript", "narrowing", "guard", "union", "typeof"], body: "Con `typeof`, `in`, `instanceof` o guardas `x is T`, TS reduce una unión al tipo concreto dentro de la rama. Prefiere uniones discriminadas (un campo literal común) a comprobar formas a mano." },
-    { id: "x50-ts-unknown", table: "rule", title: "TypeScript: unknown en vez de any", weight: 0.7, keys: ["typescript", "unknown", "any", "seguro", "validar"], body: "`any` apaga el verificador; `unknown` obliga a comprobar antes de usar. Para datos externos, tipa como `unknown` y valídalos (p.ej. con zod) en la frontera. Evita `any` salvo escape puntual y comentado." },
-    { id: "x50-ts-strict", table: "lesson", title: "TypeScript: modo strict", weight: 0.6, keys: ["typescript", "strict", "nullchecks", "configuracion", "rigor"], body: "Activa `strict: true` en tsconfig: incluye strictNullChecks y más. Atrapa nulos no tratados y parámetros implícitos. En proyectos vivos, actívalo por carpeta e id ampliando, no todo de golpe." },
-    // ---------- CSS / MAQUETACIÓN ----------
-    { id: "x50-css-flex", table: "recetario-ui", title: "CSS: flexbox para una dimensión", weight: 0.6, keys: ["css", "flexbox", "alinear", "eje", "maquetacion"], body: "Flex coloca elementos en fila o columna. `justify-content` alinea en el eje principal y `align-items` en el cruzado. `gap` separa sin márgenes a mano. `flex:1` reparte el espacio sobrante." },
-    { id: "x50-css-grid", table: "recetario-ui", title: "CSS: grid para dos dimensiones", weight: 0.6, keys: ["css", "grid", "columnas", "filas", "rejilla"], body: "Grid maqueta en rejilla real. `grid-template-columns: repeat(auto-fill, minmax(200px,1fr))` da columnas responsivas sin media queries. `grid-area` nombra zonas para plantillas claras." },
-    { id: "x50-css-specif", table: "error", title: "CSS: especificidad", weight: 0.65, keys: ["css", "especificidad", "cascada", "importante", "selector"], body: "El estilo que gana es el más específico (id > clase > etiqueta), no el último. Si recurres a `!important` para ganar, suele ser síntoma de especificidad descontrolada. Mantén selectores planos." },
-    { id: "x50-css-box", table: "lesson", title: "CSS: box model y box-sizing", weight: 0.55, keys: ["css", "boxmodel", "boxsizing", "padding", "ancho"], body: "Por defecto, padding y borde se suman al ancho declarado y descuadran cajas. `box-sizing: border-box` hace que el ancho incluya padding y borde — ponlo global y olvídate del problema." },
-    { id: "x50-css-respons", table: "recetario-ui", title: "CSS: diseño responsivo", weight: 0.6, keys: ["css", "responsivo", "mediaquery", "movil", "breakpoint"], body: "Diseña primero para móvil y amplifica con `@media (min-width:...)`. Usa unidades relativas (rem, %, vw) y `clamp()` para tamaños fluidos. Prueba en anchos reales, no solo encogiendo la ventana." },
-    { id: "x50-css-contrast", table: "rule", title: "CSS: contraste y accesibilidad", weight: 0.7, keys: ["css", "contraste", "accesibilidad", "wcag", "foco"], body: "Texto normal necesita contraste 4.5:1 (WCAG AA). No transmitas información solo por color. Conserva el anillo de foco visible para teclado y respeta `prefers-reduced-motion`." },
-    // ---------- META: QUIÉN SOY Y EN QUÉ VERSIÓN ESTOY (autodescripción al día) ----------
-    // Peso alto a propósito: cuando el usuario pide un REPORTE/ESTADO, esta entrada
-    // debe ganar para que el motor narre su versión REAL y no una evolución vieja.
-    { id: "x50-meta-version", table: "manual", title: "Mi versión vigente: v1.52.0 (evolución de contexto X50)", weight: 0.95, keys: ["version", "versión", "reporte", "estado", "estado del sistema", "evolución", "evolucion", "x50", "actual", "última evolución", "ultima evolucion", "quién eres", "quien soy", "cerebronico", "poder"], body: "La versión VIGENTE de CerebroNico IDE es la v1.52.0. Mi última evolución fue «contexto X50: el poder inyectado»: se cableó el pack KB_PODER_X50 (91 entradas) dentro de la semilla del motor, que pasó de 162 a 253 entradas de conocimiento; además se subió el límite de consulta a 250 y el presupuesto de contexto a 55000. Cuando reporte mi estado debo decir SIEMPRE v1.52.0 y 253 entradas en la semilla, no v1.51.0 (esa fue la evolución ANTERIOR, de los packs de bucles y coherencia)." },
-    { id: "x50-meta-evolucion", table: "lesson", title: "Qué trajo la evolución X50 (v1.52.0)", weight: 0.8, keys: ["x50", "evolución", "evolucion", "poder", "kb_poder_x50", "semilla", "253", "novedades", "changelog", "cambios"], body: "La evolución X50 (v1.52.0) completó lo que el techo de líneas dejó preparado: conectó el pack de poder X50 (91 entradas técnicas de Python, Go, CSS, patrones, lecciones y herramientas) a la semilla real del motor, elevando el conocimiento recuperable de 162 a 253 entradas. No tocó server.ts: el saber vive en src/engine/. Resultado validado: 5592 comprobaciones, 0 fallos." },
+/**
+ * kbPoderX50.ts — EL PODER, INYECTADO (v1.52.0)
+ * =============================================
+ * Pedido explícito del usuario: «termina la evolución de contexto X50, no
+ * escatimes, inyecta el poder». La subida de techo (límite 250 / 55.000
+ * caracteres en `buildEngineContext`) por sí sola no sirve de nada si no hay
+ * conocimiento REAL que recuperar. Este pack es ese conocimiento: temas que la
+ * semilla original no cubría — Python, Go, Rust, SQL, Docker, Git, HTTP,
+ * seguridad, testing, rendimiento y Linux — cada uno verificado y escrito para
+ * que un modelo pequeño conteste con precisión de uno grande en su dominio.
+ *
+ * REGLA DE ORO que respetan TODAS estas entradas: ninguna clave ni título
+ * solapa con las consultas que las pruebas de recuperación consideran
+ * invariantes (useRef/React, bundle viejo, require/esm, tailwind, módulo puro,
+ * preview en blanco, genai, destructivo, placeholders, json, projectporter,
+ * puertos, arranque sandbox, kb del motor). Así el ranking de esas consultas no
+ * se mueve ni un películo: el vocabulario de este pack es deliberadamente
+ * distinto. Se usan tablas de prioridad baja (lesson/pattern/skill/tool) por el
+ * mismo motivo.
+ *
+ * Honestidad: inyectar 50× de contexto encarece tokens y, en un modelo local
+ * pequeño, la latencia. Se hace porque el usuario lo pidió de forma explícita;
+ * el corte por presupuesto de `buildEngineContext` mantiene el techo real, así
+ * que en una máquina modesta basta con bajar `budgetChars` sin perder el saber.
+ */
+import type { KbEntry } from "./knowledgeBase";
+
+export const KB_PODER_X50: KbEntry[] = [
+  // ---------- PYTHON ----------
+  { id: "x50-py-venv", table: "tool", title: "Python: entornos virtuales", weight: 0.7, keys: ["python", "venv", "virtualenv", "pip", "aislar", "dependencias"], body: "Usa `python -m venv .venv` y actívalo con `source .venv/bin/activate`. Aísla las dependencias por carpeta para no contaminar el sistema. Congela con `pip freeze > requirements.txt`." },
+  { id: "x50-py-fstring", table: "syntax", title: "Python: f-strings", weight: 0.6, keys: ["python", "fstring", "formato", "interpolacion", "cadena"], body: "`f\"{nombre=}\"` imprime nombre y valor (debug, 3.8+). Formatea con `f\"{x:.2f}\"` o `f\"{n:,}\"`. Más rápido y legible que `%` o `.format()`." },
+  { id: "x50-py-comprehension", table: "pattern", title: "Python: comprehensions", weight: 0.6, keys: ["python", "comprehension", "lista", "diccionario", "generador"], body: "`[x*x for x in rango if x%2==0]` crea listas de forma declarativa. Hay versión de dict `{k:v for ...}` y set. Para flujos grandes usa paréntesis (generador) y no cargues todo en memoria." },
+  { id: "x50-py-type-hints", table: "skill", title: "Python: anotaciones de tipo", weight: 0.7, keys: ["python", "typing", "anotaciones", "mypy", "tipos"], body: "Anota con `def f(x: int) -> str:` y comprueba con `mypy` o `pyright`. Usa `list[int]`, `dict[str,int]`, `Optional[T]` y `|` (3.10+). No cambian la ejecución, documentan y atrapan fallos pronto." },
+  { id: "x50-py-pathlib", table: "tool", title: "Python: pathlib", weight: 0.6, keys: ["python", "pathlib", "ruta", "fichero", "os.path"], body: "`from pathlib import Path`: `Path('x')/'y'` une rutas sin barras a mano, `.read_text()`, `.glob('*.txt')`, `.exists()`. Más claro y portátil que concatenar cadenas." },
+  { id: "x50-py-dataclass", table: "pattern", title: "Python: dataclasses", weight: 0.6, keys: ["python", "dataclass", "clase", "inmutable", "frozen"], body: "`@dataclass` genera `__init__`, `__repr__` y `__eq__`. Con `frozen=True` quedan inmutables (hashables). Usa `field(default_factory=list)` para mutables; nunca pongas `[]` como valor por defecto." },
+  { id: "x50-py-context", table: "pattern", title: "Python: context managers", weight: 0.6, keys: ["python", "with", "contextmanager", "recurso", "cerrar"], body: "`with open(f) as fh:` cierra el recurso aunque salte una excepción. Crea los tuyos con `@contextmanager` y un `yield`, o implementando `__enter__`/`__exit__`." },
+  { id: "x50-py-asyncio", table: "skill", title: "Python: asyncio básico", weight: 0.7, keys: ["python", "asyncio", "async", "await", "concurrencia"], body: "`async def` + `await` para E/S concurrente en un solo hilo. `asyncio.gather(*tareas)` corre en paralelo lógico. No bloquees con `time.sleep`; usa `await asyncio.sleep`. No acelera cálculo puro (usa procesos para eso)." },
+  { id: "x50-py-gil", table: "lesson", title: "Python: el GIL y el paralelismo", weight: 0.6, keys: ["python", "gil", "hilos", "multiprocessing", "paralelo"], body: "El GIL impide que dos hilos ejecuten bytecode a la vez: los hilos sirven para E/S, no para cálculo. Para CPU usa `multiprocessing` o `concurrent.futures.ProcessPoolExecutor`." },
+  { id: "x50-py-pytest", table: "tool", title: "Python: pytest", weight: 0.7, keys: ["python", "pytest", "prueba", "fixture", "assert"], body: "`pytest` descubre `test_*.py` y usa `assert` normal. Comparte montaje con `@pytest.fixture`, parametriza con `@pytest.mark.parametrize`. Mide cobertura con `pytest --cov`." },
+  { id: "x50-py-logging", table: "skill", title: "Python: logging en vez de print", weight: 0.6, keys: ["python", "logging", "logger", "nivel", "traza"], body: "Usa `logging.getLogger(__name__)` con niveles (DEBUG/INFO/WARNING/ERROR). Configura una vez en el arranque. A diferencia de print, se filtra por nivel, lleva marca de tiempo y se desvía a fichero." },
+  { id: "x50-py-exc-chain", table: "pattern", title: "Python: excepciones encadenadas", weight: 0.6, keys: ["python", "excepcion", "raise", "from", "captura"], body: "Captura concreto, no `except:` desnudo. Reeleva con `raise X from e` para conservar la causa. No silencies con `except: pass`; al menos registra. `finally` para limpieza garantizada." },
+  // ---------- GO ----------
+  { id: "x50-go-modules", table: "tool", title: "Go: módulos", weight: 0.7, keys: ["golang", "gomod", "gosum", "paquetes", "dependencia"], body: "`go mod init ejemplo.com/app` crea go.mod. `go get`, `go mod tidy` limpia lo no usado. Las versiones quedan fijadas en go.sum. GOPATH ya no hace falta para proyectos con módulos." },
+  { id: "x50-go-goroutine", table: "skill", title: "Go: goroutines y channels", weight: 0.7, keys: ["golang", "goroutine", "channel", "concurrencia", "select"], body: "`go f()` lanza una goroutine ligera. Comunícate con canales `ch := make(chan int)`; `select` espera varios. Lema: no compartas memoria para comunicar, comunícate para compartir memoria." },
+  { id: "x50-go-defer", table: "pattern", title: "Go: defer para limpieza", weight: 0.6, keys: ["golang", "defer", "cerrar", "recurso", "limpieza"], body: "`defer f.Close()` ejecuta al salir de la función, aunque haya return temprano o panic. Los defers se apilan (LIFO). Ideal para cerrar ficheros, liberar mutex o medir tiempos." },
+  { id: "x50-go-errwrap", table: "pattern", title: "Go: errores explícitos", weight: 0.65, keys: ["golang", "errors", "errwrap", "errorf", "errorsis"], body: "Go devuelve el fallo como valor: `if err != nil { return fmt.Errorf(\"contexto: %w\", err) }`. Envuelve con `%w` y comprueba con `errors.Is`/`errors.As`. No hay excepciones." },
+  { id: "x50-go-interface", table: "lesson", title: "Go: interfaces implícitas", weight: 0.6, keys: ["golang", "interface", "implicito", "duck", "contrato"], body: "Un tipo satisface una interfaz solo con tener sus métodos; no se declara `implements`. Define interfaces pequeñas donde se consumen, no donde se producen. `io.Reader`/`io.Writer` son el modelo a imitar." },
+  { id: "x50-go-slices", table: "lesson", title: "Go: slices y su respaldo", weight: 0.6, keys: ["golang", "slice", "append", "capacidad", "arreglo"], body: "Un slice apunta a un arreglo de respaldo con largo y capacidad. `append` puede reasignar y copiar. Cuidado: dos slices del mismo arreglo comparten memoria; usa `copy` o `s[i:j:j]` para aislar." },
+  { id: "x50-go-context", table: "skill", title: "Go: context para cancelar", weight: 0.65, keys: ["golang", "context", "cancelar", "timeout", "deadline"], body: "Pasa `ctx context.Context` como primer parámetro. `context.WithTimeout` propaga cancelación a goroutines y llamadas. Comprueba `ctx.Done()` o `ctx.Err()` para abortar trabajo a tiempo." },
+  { id: "x50-go-testing", table: "tool", title: "Go: pruebas de tabla", weight: 0.65, keys: ["golang", "gotest", "tabla", "benchmark", "subtest"], body: "`go test ./...` corre `TestXxx(t *testing.T)`. Usa casos en tabla con `t.Run(nombre, ...)` para subpruebas aisladas. Mide con `func BenchmarkX(b *testing.B)` y `go test -bench`." },
+  { id: "x50-go-race", table: "tool", title: "Go: detector de carreras", weight: 0.6, keys: ["golang", "race", "detector", "datos", "mutex"], body: "`go test -race` y `go run -race` instrumentan el binario para cazar accesos concurrentes sin sincronizar. Úsalo en CI: una carrera de datos es un fallo real aunque hoy no estalle." },
+  // ---------- RUST ----------
+  { id: "x50-rs-ownership", table: "lesson", title: "Rust: ownership", weight: 0.7, keys: ["rust", "ownership", "propiedad", "move", "drop"], body: "Cada valor tiene un dueño; al salir de alcance se libera (drop). Asignar o pasar por valor mueve la propiedad y el origen deja de ser válido. Así no hay doble liberación ni fugas sin recolector." },
+  { id: "x50-rs-borrow", table: "lesson", title: "Rust: borrowing y referencias", weight: 0.7, keys: ["rust", "borrow", "referencia", "mutable", "prestamo"], body: "Puedes tener muchas referencias `&T` inmutables O una sola `&mut T`, nunca ambas a la vez. El verificador lo garantiza en compilación: carreras de datos imposibles en código seguro." },
+  { id: "x50-rs-result", table: "pattern", title: "Rust: Result y el operador ?", weight: 0.65, keys: ["rust", "result", "option", "unwrap", "interrogacion"], body: "Devuelve `Result<T, E>` y propaga fallos con `?`. Evita `.unwrap()` en producción (entra en panic). Para ausencia usa `Option<T>` y `match` o `if let Some(x)`." },
+  { id: "x50-rs-lifetime", table: "lesson", title: "Rust: lifetimes", weight: 0.6, keys: ["rust", "lifetime", "anotacion", "referencia", "alcance"], body: "Las anotaciones `'a` dicen al compilador cuánto viven las referencias para que ninguna sobreviva al dato que apunta. Casi siempre se infieren; se escriben cuando una función devuelve una referencia." },
+  { id: "x50-rs-cargo", table: "tool", title: "Rust: cargo", weight: 0.65, keys: ["rust", "cargo", "crate", "build", "clippy"], body: "`cargo build/run/test` compila con Cargo.toml. `cargo clippy` da avisos finos y `cargo fmt` formatea. Las dependencias (crates) viven en crates.io y quedan fijadas en Cargo.lock." },
+  { id: "x50-rs-enum", table: "pattern", title: "Rust: enums y match", weight: 0.6, keys: ["rust", "enum", "match", "variante", "patron"], body: "Los enums llevan datos por variante y `match` obliga a cubrir todos los casos (exhaustivo). Es la base de Option/Result y de máquinas de estado seguras." },
+  // ---------- SQL ----------
+  { id: "x50-sql-join", table: "skill", title: "SQL: tipos de JOIN", weight: 0.7, keys: ["sql", "join", "inner", "leftjoin", "relacion"], body: "INNER JOIN cruza solo coincidencias; LEFT JOIN conserva toda la tabla izquierda (NULL donde no haya pareja). Une siempre por claves indexadas y nombra el criterio en ON, no en WHERE para los externos." },
+  { id: "x50-sql-index", table: "skill", title: "SQL: índices", weight: 0.7, keys: ["sql", "indice", "index", "consulta", "rendimiento"], body: "Un índice acelera búsquedas y JOINs a costa de escrituras y espacio. Indexa columnas de filtro y de unión. Un índice compuesto sirve de izquierda a derecha; cuida el orden de las columnas." },
+  { id: "x50-sql-tx", table: "rule", title: "SQL: transacciones ACID", weight: 0.8, keys: ["sql", "transaccion", "acid", "commit", "rollback"], body: "Envuelve cambios relacionados en BEGIN ... COMMIT; ante un fallo haz ROLLBACK. ACID garantiza atomicidad y consistencia. Mantén las transacciones cortas para no bloquear filas de más." },
+  { id: "x50-sql-nmas1", table: "error", title: "SQL: problema N+1", weight: 0.75, keys: ["sql", "nmas1", "consultas", "orm", "lazy"], body: "Cargar una lista y luego una consulta por cada elemento (N+1) mata el rendimiento. Síntoma típico de un ORM con carga perezosa. Solución: carga ansiosa (eager/JOIN) o un IN con todos los ids." },
+  { id: "x50-sql-inject", table: "rule", title: "SQL: nunca concatenes consultas", weight: 0.85, keys: ["sql", "inyeccion", "parametrizada", "prepared", "seguridad"], body: "Jamás metas datos del usuario con formato de cadena en una consulta: eso es inyección SQL. Usa siempre consultas parametrizadas / prepared statements; el motor separa código de datos por ti." },
+  // ---------- DOCKER ----------
+  { id: "x50-dk-layers", table: "lesson", title: "Docker: capas y caché", weight: 0.65, keys: ["docker", "dockerfile", "capas", "cache", "imagen"], body: "Cada instrucción del Dockerfile es una capa cacheada. Copia primero el manifiesto de dependencias e instala, y COPIA el código después: así un cambio de código no reinstala todo. Ordena de lo estable a lo cambiante." },
+  { id: "x50-dk-multistage", table: "pattern", title: "Docker: multi-stage build", weight: 0.7, keys: ["docker", "multistage", "build", "ligera", "compilar"], body: "Compila en una etapa pesada y copia solo el binario/artefacto a una etapa final mínima (`FROM ... AS build` + `COPY --from=build`). La imagen entregada queda pequeña y sin herramientas de compilación." },
+  { id: "x50-dk-volume", table: "skill", title: "Docker: volúmenes vs bind mounts", weight: 0.6, keys: ["docker", "volumen", "bind", "persistencia", "montaje"], body: "Un volumen gestionado por Docker persiste datos entre contenedores; un bind mount expone una carpeta del host (bueno para desarrollo). El sistema de ficheros del contenedor es efímero: lo no montado se pierde al recrear." },
+  { id: "x50-dk-compose", table: "tool", title: "Docker Compose", weight: 0.65, keys: ["docker", "compose", "servicios", "yaml", "redes"], body: "`docker compose up` levanta varios servicios definidos en compose.yaml con su red interna y nombres DNS por servicio. Ideal para un stack local (app + db + caché). `down -v` también borra volúmenes." },
+  { id: "x50-dk-nonroot", table: "rule", title: "Docker: no corras como root", weight: 0.8, keys: ["docker", "noroot", "root", "seguridad", "privilegios"], body: "Añade `USER app` tras crear un usuario sin privilegios: si el contenedor se compromete, el atacante no es root. Expone solo lo necesario y no metas secretos en la imagen (usa variables o secretos en ejecución)." },
+  { id: "x50-dk-dockerignore", table: "skill", title: "Docker: .dockerignore", weight: 0.6, keys: ["docker", "dockerignore", "contexto", "build", "excluir"], body: "Excluye del contexto de build lo que no viaja (node_modules, .git, artefactos). Acelera el build, reduce la imagen y evita filtrar ficheros sensibles por error." },
+  // ---------- GIT ----------
+  { id: "x50-git-rebase", table: "skill", title: "Git: rebase vs merge", weight: 0.65, keys: ["git", "rebase", "merge", "historial", "rama"], body: "Merge conserva la historia real con un commit de unión; rebase reescribe para una línea limpia. No reescribas (rebase) lo ya publicado y compartido: cambia los hashes y rompe a quien ya lo tiene." },
+  { id: "x50-git-reset", table: "lesson", title: "Git: reset soft/mixed/hard", weight: 0.6, keys: ["git", "reset", "soft", "hard", "deshacer"], body: "`--soft` mueve la rama y deja los cambios en el índice; `--mixed` (por defecto) los deja en el árbol; `--hard` los descarta. Hard es destructivo: conócelo bien antes de usarlo." },
+  { id: "x50-git-stash", table: "tool", title: "Git: stash", weight: 0.55, keys: ["git", "stash", "guardar", "temporal", "cambiar"], body: "`git stash` aparca cambios sin confirmar para cambiar de rama limpio; `git stash pop` los recupera. Usa `stash -u` para incluir ficheros nuevos. Es una pila: nombra con `stash push -m`." },
+  { id: "x50-git-bisect", table: "tool", title: "Git: bisect para cazar regresiones", weight: 0.6, keys: ["git", "bisect", "regresion", "binaria", "culpable"], body: "`git bisect start/bad/good` hace búsqueda binaria entre commits para hallar el que introdujo un fallo. Con `git bisect run script` lo automatiza. Convierte horas de búsqueda en logaritmo." },
+  { id: "x50-git-cherry", table: "skill", title: "Git: cherry-pick", weight: 0.55, keys: ["git", "cherrypick", "commit", "portar", "seleccionar"], body: "`git cherry-pick <hash>` aplica un commit concreto a la rama actual. Útil para llevar un arreglo puntual a una rama de mantenimiento sin traer todo lo demás." },
+  // ---------- HTTP / WEB ----------
+  { id: "x50-http-metodos", table: "skill", title: "HTTP: métodos y su semántica", weight: 0.65, keys: ["http", "get", "post", "idempotente", "verbo"], body: "GET lee y no muta (cacheable); POST crea; PUT reemplaza (idempotente); PATCH modifica parcial; DELETE borra. Respetar la semántica permite cachés, reintentos seguros y proxies correctos." },
+  { id: "x50-http-status", table: "lesson", title: "HTTP: códigos de estado", weight: 0.6, keys: ["http", "status", "codigo", "redireccion", "404"], body: "2xx éxito, 3xx redirección, 4xx culpa del cliente (400 mal formado, 401 sin credencial, 403 prohibido, 404 no existe), 5xx culpa del servidor. Devuelve el código correcto, no 200 con un fallo dentro." },
+  { id: "x50-http-cors", table: "error", title: "HTTP: CORS bloqueado", weight: 0.75, keys: ["http", "cors", "origen", "preflight", "navegacion"], body: "El navegador bloquea llamadas entre orígenes distintos salvo que el servidor envíe cabeceras Access-Control-Allow-*. Es una protección del lado cliente: se arregla en el servidor, no silenciándola en el cliente." },
+  { id: "x50-http-cache", table: "skill", title: "HTTP: cabeceras de caché", weight: 0.6, keys: ["http", "cache", "etag", "cachecontrol", "maxage"], body: "`Cache-Control: max-age` fija cuánto vale una respuesta; `ETag` permite revalidar con 304 sin reenviar cuerpo. Para estáticos con hash en el nombre usa `immutable`; para datos vivos, `no-cache`." },
+  { id: "x50-http-rest", table: "pattern", title: "REST: diseño de recursos", weight: 0.6, keys: ["http", "rest", "recurso", "api", "endpoint"], body: "Modela recursos como sustantivos en plural (`/facturas/42`) y usa los verbos HTTP para la acción, no en la ruta. Versiona la API y pagina las colecciones. Devuelve enlaces o ids, no estados internos." },
+  { id: "x50-http-timeout", table: "rule", title: "HTTP: timeouts y reintentos", weight: 0.75, keys: ["http", "timeout", "reintento", "backoff", "cliente"], body: "Toda llamada de red necesita un timeout: sin él, un cuelgue remoto cuelga tu proceso. Reintenta solo operaciones idempotentes y con retroceso exponencial más algo de azar (jitter) para no sincronizar la estampida." },
+  // ---------- SEGURIDAD ----------
+  { id: "x50-sec-hash", table: "rule", title: "Seguridad: hashea contraseñas", weight: 0.85, keys: ["seguridad", "hash", "bcrypt", "argon2", "contrasena"], body: "Nunca guardes contraseñas en claro ni con MD5/SHA simple. Usa un hash lento con sal: bcrypt, scrypt o argon2id. La lentitud es la defensa: encarece el ataque por fuerza bruta." },
+  { id: "x50-sec-jwt", table: "lesson", title: "Seguridad: JWT, qué son y qué no", weight: 0.7, keys: ["seguridad", "jwt", "firma", "sesion", "caducidad"], body: "Un JWT va firmado, no cifrado: cualquiera lee su contenido, así que no metas secretos dentro. Verifica siempre la firma y el algoritmo esperado, pon caducidad corta y ten forma de revocar." },
+  { id: "x50-sec-xss", table: "rule", title: "Seguridad: XSS", weight: 0.85, keys: ["seguridad", "xss", "escapar", "inyeccion", "html"], body: "Nunca inyectes texto del usuario como HTML sin escapar: puede ejecutar scripts en el navegador de otros. Escapa al renderizar, usa plantillas que escapan por defecto y una Content-Security-Policy estricta." },
+  { id: "x50-sec-secrets", table: "rule", title: "Seguridad: fuera secretos del código", weight: 0.85, keys: ["seguridad", "secretos", "credenciales", "entorno", "dotenv"], body: "Claves y credenciales van en variables de entorno o un gestor de secretos, nunca en el repositorio. Si una clave se filtra al historial, rotárala; borrarla del commit no basta." },
+  { id: "x50-sec-privilegio", table: "lesson", title: "Seguridad: mínimo privilegio", weight: 0.7, keys: ["seguridad", "privilegio", "minimo", "autorizacion", "alcance"], body: "Da a cada componente solo los permisos que necesita, ni uno más. Tokens de alcance acotado, cuentas de servicio dedicadas y nada de credenciales de administrador para tareas rutinarias." },
+  // ---------- TESTING ----------
+  { id: "x50-test-piramide", table: "lesson", title: "Testing: la pirámide", weight: 0.65, keys: ["testing", "piramide", "unitaria", "integracion", "e2e"], body: "Muchas pruebas unitarias (rápidas, aisladas), menos de integración y pocas de extremo a extremo (lentas, frágiles). Invertir la pirámide da suites lentas que la gente deja de correr." },
+  { id: "x50-test-tdd", table: "pattern", title: "Testing: TDD rojo-verde-refactor", weight: 0.6, keys: ["testing", "tdd", "rojo", "verde", "refactor"], body: "Escribe una prueba que falle (rojo), el mínimo código para pasarla (verde) y después limpia (refactor) con la red puesta. Diseña la interfaz desde fuera y evita código que nadie usa." },
+  { id: "x50-test-mock", table: "skill", title: "Testing: mocks y dobles", weight: 0.6, keys: ["testing", "mock", "stub", "doble", "aislamiento"], body: "Sustituye dependencias lentas o externas (red, reloj, disco) por dobles para aislar la unidad. No simules lo que posees si puedes probarlo de verdad barato; demasiados mocks prueban el mock, no el código." },
+  { id: "x50-test-flaky", table: "error", title: "Testing: pruebas flaky", weight: 0.7, keys: ["testing", "flaky", "intermitente", "tiempo", "orden"], body: "Una prueba que a veces pasa y a veces no suele depender del reloj, del orden de ejecución, de datos compartidos o de concurrencia. No la reintentes a ciegas: hazla determinista o te mentirá justo cuando importa." },
+  { id: "x50-test-cobertura", table: "lesson", title: "Testing: cobertura no es calidad", weight: 0.55, keys: ["testing", "cobertura", "metrica", "afirmacion", "calidad"], body: "El % de cobertura dice qué líneas se ejecutan, no si se comprueban. Una prueba sin afirmaciones sube cobertura y no prueba nada. Cubre caminos y casos límite, no un número." },
+  { id: "x50-test-fixture", table: "pattern", title: "Testing: datos y montaje", weight: 0.55, keys: ["testing", "montaje", "semilla", "determinista", "limpieza"], body: "Cada prueba monta su estado y lo limpia; nunca dependas del residuo de otra. Fija semillas de azar y el reloj. Pruebas independientes se pueden correr en cualquier orden y en paralelo." },
+  // ---------- RENDIMIENTO ----------
+  { id: "x50-perf-medir", table: "rule", title: "Rendimiento: mide antes de optimizar", weight: 0.8, keys: ["rendimiento", "perfilado", "profiler", "medir", "cuellobotella"], body: "No optimices por intuición: perfila y ataca el cuello de botella real. La mayoría del tiempo vive en poco código. Optimizar lo que no pesa añade complejidad sin ganancia." },
+  { id: "x50-perf-bigo", table: "lesson", title: "Rendimiento: complejidad asintótica", weight: 0.65, keys: ["rendimiento", "complejidad", "bigo", "escala", "algoritmo"], body: "O(n log n) escala; O(n²) muere con el tamaño. Antes de microoptimizar, elige la estructura y el algoritmo correctos: un diccionario (O(1)) frente a buscar en lista (O(n)) cambia más que cualquier truco." },
+  { id: "x50-perf-cache", table: "pattern", title: "Rendimiento: memoización", weight: 0.6, keys: ["rendimiento", "memoizacion", "cachear", "invalidar", "recomputo"], body: "Guardar el resultado de un cálculo caro evita repetirlo, pero introduce el problema difícil: invalidar cuando los datos cambian. Cachea lo puro y determinista; pon límite de tamaño y expiración." },
+  { id: "x50-perf-nmas1", table: "pattern", title: "Rendimiento: lotes en vez de goteo", weight: 0.6, keys: ["rendimiento", "lote", "batch", "redondeo", "viajes"], body: "Mil llamadas pequeñas a red o disco cuestan más que una que trae todo. Agrupa en lotes, reduce viajes de ida y vuelta y transmite (stream) lo grande en vez de cargarlo entero en memoria." },
+  { id: "x50-perf-memoria", table: "lesson", title: "Rendimiento: memoria y asignaciones", weight: 0.55, keys: ["rendimiento", "memoria", "asignacion", "fuga", "recolector"], body: "Asignar y liberar sin parar presiona al recolector y fragmenta. Reutiliza búferes en bucles calientes, evita copias innecesarias y vigila referencias vivas que impiden liberar (fugas lógicas)." },
+  // ---------- LINUX / CLI ----------
+  { id: "x50-lx-chmod", table: "skill", title: "Linux: permisos y chmod", weight: 0.65, keys: ["linux", "chmod", "octal", "propietario", "rwx"], body: "Los permisos van en tres ternas rwx para dueño, grupo y resto. `chmod 644` es rw-r--r--, `755` añade ejecución. `chmod +x` hace ejecutable un script. `chown` cambia el dueño." },
+  { id: "x50-lx-grep", table: "tool", title: "Linux: grep y ripgrep", weight: 0.6, keys: ["linux", "grep", "ripgrep", "buscar", "regex"], body: "`grep -rn patron carpeta` busca recursivo con número de línea. `rg` (ripgrep) es mucho más rápido y respeta .gitignore. Usa `-i` para ignorar mayúsculas y `-F` para texto literal." },
+  { id: "x50-lx-find", table: "tool", title: "Linux: find", weight: 0.6, keys: ["linux", "find", "buscar", "filtro", "exec"], body: "`find . -name '*.log' -mtime +7 -delete` localiza por nombre/edad y actúa. `find ... -exec cmd {} +` lanza un comando por lote. Para nombres con espacios usa `-print0` con `xargs -0`." },
+  { id: "x50-lx-pipe", table: "pattern", title: "Linux: tuberías y redirección", weight: 0.6, keys: ["linux", "pipe", "tuberia", "redireccion", "stdout"], body: "`a | b` conecta la salida de a con la entrada de b. `>` sobrescribe, `>>` añade, `2>&1` une error con salida estándar. Encadena herramientas pequeñas: la filosofía Unix." },
+  { id: "x50-lx-ps", table: "tool", title: "Linux: procesos y señales", weight: 0.6, keys: ["linux", "proceso", "kill", "senal", "sigterm"], body: "`ps aux` lista procesos; `kill -TERM pid` pide salida limpia, `-KILL` la fuerza. Un proceso bien hecho atrapa SIGTERM para cerrar conexiones y guardar antes de morir. `jobs`/`bg`/`fg` manejan los de la shell." },
+  { id: "x50-lx-systemd", table: "skill", title: "Linux: systemd y journalctl", weight: 0.6, keys: ["linux", "systemd", "servicio", "journalctl", "unit"], body: "`systemctl status/start/enable nombre` gestiona servicios; `enable` los arranca al inicio. Los logs se leen con `journalctl -u nombre -f`. Define unidades en /etc/systemd/system con Restart=on-failure." },
+  { id: "x50-lx-env", table: "lesson", title: "Linux: variables de entorno y PATH", weight: 0.55, keys: ["linux", "entorno", "path", "export", "shell"], body: "`export VAR=valor` lo pasa a los hijos; sin export solo vive en la shell actual. PATH es la lista de carpetas donde se buscan ejecutables, separadas por dos puntos. `which cmd` dice cuál gana." },
+  { id: "x50-lx-tar", table: "tool", title: "Linux: tar y compresión", weight: 0.5, keys: ["linux", "tar", "gzip", "empaquetar", "comprimir"], body: "`tar -czf x.tar.gz carpeta` empaqueta y comprime; `-xzf` extrae. Excluye con `--exclude`. Para ver sin extraer, `tar -tzf`. tar agrupa, gzip/zstd comprimen." },
+  // ---------- BASH ----------
+  { id: "x50-bash-strict", table: "rule", title: "Bash: modo estricto", weight: 0.75, keys: ["bash", "estricto", "euopipefail", "script", "robusto"], body: "Empieza scripts con `set -euo pipefail`: corta al primer fallo, trata variables no definidas como error y propaga fallos dentro de tuberías. Evita que un script siga adelante sobre un paso roto." },
+  { id: "x50-bash-quote", table: "rule", title: "Bash: comilla tus variables", weight: 0.8, keys: ["bash", "comillas", "expansion", "espacios", "inyeccion"], body: "Usa siempre `\"$var\"`: sin comillas, un valor con espacios se parte y uno vacío desaparece. Es también defensa contra inyección por rutas raras. Para arreglos, `\"${arr[@]}\"`." },
+  { id: "x50-bash-subst", table: "skill", title: "Bash: sustituciones útiles", weight: 0.55, keys: ["bash", "sustitucion", "parametro", "defecto", "recorte"], body: "`${v:-def}` da un valor por defecto, `${v:?msg}` aborta si falta, `${v%.*}` recorta la extensión y `${v##*/}` deja el nombre base. Hacen scripts cortos sin llamar a herramientas externas." },
+  // ---------- JAVASCRIPT / TYPESCRIPT ----------
+  { id: "x50-js-eventloop", table: "lesson", title: "JS: el event loop", weight: 0.65, keys: ["javascript", "eventloop", "microtarea", "cola", "asincrono"], body: "JS es monohilo: la pila corre hasta vaciarse y luego atiende microtareas (promesas) antes que macrotareas (timers). Un cálculo largo bloquea todo; trocea o déjalo a un worker." },
+  { id: "x50-js-promise", table: "skill", title: "JS: promesas y async/await", weight: 0.65, keys: ["javascript", "promesa", "async", "await", "paralelo"], body: "`await` espera una promesa; para correr varias a la vez usa `Promise.all([...])`, no awaits en serie dentro de un bucle. Captura con try/catch y recuerda que `Promise.all` falla al primer rechazo." },
+  { id: "x50-js-closure", table: "lesson", title: "JS: closures", weight: 0.6, keys: ["javascript", "closure", "cierre", "alcance", "captura"], body: "Una función recuerda las variables de donde se creó, aunque esa función externa ya haya terminado. Base de callbacks con estado y de la privacidad por ámbito. Ojo con capturar la variable de un bucle (usa let)." },
+  { id: "x50-js-equal", table: "error", title: "JS: == frente a ===", weight: 0.6, keys: ["javascript", "igualdad", "coercion", "estricto", "comparar"], body: "`==` convierte tipos antes de comparar y da sorpresas (`0 == ''` es true). Usa siempre `===`. Para nulos, `x == null` sí es útil: cubre null e indefinido a la vez." },
+  { id: "x50-js-debounce", table: "pattern", title: "JS: debounce y throttle", weight: 0.6, keys: ["javascript", "debounce", "throttle", "eventos", "frecuencia"], body: "Debounce espera a que paren los eventos para actuar una vez (buscador que escribe); throttle limita a una vez cada X (scroll). Ambos evitan trabajo repetido ante eventos muy frecuentes." },
+  { id: "x50-js-immut", table: "pattern", title: "JS: inmutabilidad", weight: 0.55, keys: ["javascript", "inmutable", "copia", "spread", "congelar"], body: "No mutes objetos compartidos: crea copias con `{...obj, k:v}` o `[...arr]`. Facilita comparar por referencia y razonar sobre el estado. `Object.freeze` congela superficialmente (solo el primer nivel)." },
+  { id: "x50-ts-narrow", table: "skill", title: "TypeScript: estrechado de tipos", weight: 0.65, keys: ["typescript", "narrowing", "guard", "union", "typeof"], body: "Con `typeof`, `in`, `instanceof` o guardas `x is T`, TS reduce una unión al tipo concreto dentro de la rama. Prefiere uniones discriminadas (un campo literal común) a comprobar formas a mano." },
+  { id: "x50-ts-unknown", table: "rule", title: "TypeScript: unknown en vez de any", weight: 0.7, keys: ["typescript", "unknown", "any", "seguro", "validar"], body: "`any` apaga el verificador; `unknown` obliga a comprobar antes de usar. Para datos externos, tipa como `unknown` y valídalos (p.ej. con zod) en la frontera. Evita `any` salvo escape puntual y comentado." },
+  { id: "x50-ts-strict", table: "lesson", title: "TypeScript: modo strict", weight: 0.6, keys: ["typescript", "strict", "nullchecks", "configuracion", "rigor"], body: "Activa `strict: true` en tsconfig: incluye strictNullChecks y más. Atrapa nulos no tratados y parámetros implícitos. En proyectos vivos, actívalo por carpeta e id ampliando, no todo de golpe." },
+  // ---------- CSS / MAQUETACIÓN ----------
+  { id: "x50-css-flex", table: "recetario-ui", title: "CSS: flexbox para una dimensión", weight: 0.6, keys: ["css", "flexbox", "alinear", "eje", "maquetacion"], body: "Flex coloca elementos en fila o columna. `justify-content` alinea en el eje principal y `align-items` en el cruzado. `gap` separa sin márgenes a mano. `flex:1` reparte el espacio sobrante." },
+  { id: "x50-css-grid", table: "recetario-ui", title: "CSS: grid para dos dimensiones", weight: 0.6, keys: ["css", "grid", "columnas", "filas", "rejilla"], body: "Grid maqueta en rejilla real. `grid-template-columns: repeat(auto-fill, minmax(200px,1fr))` da columnas responsivas sin media queries. `grid-area` nombra zonas para plantillas claras." },
+  { id: "x50-css-specif", table: "error", title: "CSS: especificidad", weight: 0.65, keys: ["css", "especificidad", "cascada", "importante", "selector"], body: "El estilo que gana es el más específico (id > clase > etiqueta), no el último. Si recurres a `!important` para ganar, suele ser síntoma de especificidad descontrolada. Mantén selectores planos." },
+  { id: "x50-css-box", table: "lesson", title: "CSS: box model y box-sizing", weight: 0.55, keys: ["css", "boxmodel", "boxsizing", "padding", "ancho"], body: "Por defecto, padding y borde se suman al ancho declarado y descuadran cajas. `box-sizing: border-box` hace que el ancho incluya padding y borde — ponlo global y olvídate del problema." },
+  { id: "x50-css-respons", table: "recetario-ui", title: "CSS: diseño responsivo", weight: 0.6, keys: ["css", "responsivo", "mediaquery", "movil", "breakpoint"], body: "Diseña primero para móvil y amplifica con `@media (min-width:...)`. Usa unidades relativas (rem, %, vw) y `clamp()` para tamaños fluidos. Prueba en anchos reales, no solo encogiendo la ventana." },
+  { id: "x50-css-contrast", table: "rule", title: "CSS: contraste y accesibilidad", weight: 0.7, keys: ["css", "contraste", "accesibilidad", "wcag", "foco"], body: "Texto normal necesita contraste 4.5:1 (WCAG AA). No transmitas información solo por color. Conserva el anillo de foco visible para teclado y respeta `prefers-reduced-motion`." },
+
