+    return { plan, reiniciadas: [], motivo: `La tarea #${id} se está ejecutando ahora mismo; cancélala o espera.` };
+  }
+  if (objetivo.estado === "hecha") {
+    return { plan, reiniciadas: [], motivo: `La tarea #${id} ya está hecha. Rehacerla vuelve a gastar el modelo: si quieres rehacer el tramo, reinicia una de las que dependen de ella.` };
+  }
+  if (objetivo.estado === "descartada") {
+    return { plan, reiniciadas: [], motivo: `La tarea #${id} fue descartada a propósito; reanúdala desde el plan, no desde aquí.` };
+  }
