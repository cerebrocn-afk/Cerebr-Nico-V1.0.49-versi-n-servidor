+export function prepararReintentoTarea(
+  plan: Plan,
+  tareaId: string,
+): { plan: Plan; reiniciadas: string[]; motivo?: string } {
+  const id = String(tareaId);
+  const objetivo = plan.tareas.find((t) => String(t.id) === id);
+  if (!objetivo) {
