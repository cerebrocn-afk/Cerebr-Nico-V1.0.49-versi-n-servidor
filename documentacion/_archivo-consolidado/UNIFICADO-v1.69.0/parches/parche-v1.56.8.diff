+  return `package ${o.appId};
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.webkit.WebChromeClient;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+/**
+ * Generado por CerebroNico · androidProyecto v1.0.
+ * Un WebView que carga la web del proyecto desde los assets del APK.
+ * Sin Capacitor ni dependencias: menos piezas, menos formas de romperse.
+ */
+public class MainActivity extends Activity {
+
+    private static final String ENTRADA = "file:///android_asset/${o.carpetaWeb}/index.html";
+
+    private WebView web;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        web = new WebView(this);
+        web.getSettings().setJavaScriptEnabled(true);
+        web.getSettings().setDomStorageEnabled(true);
+        web.getSettings().setDatabaseEnabled(true);
+        // Necesario para file:///android_asset/ (en API 30+ viene en false).
+        web.getSettings().setAllowFileAccess(true);
+        web.getSettings().setAllowContentAccess(true);
+        web.getSettings().setMediaPlaybackRequiresUserGesture(false);
+
+        web.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, String url) {
+                if (url == null) return false;
+                if (url.startsWith("file://") || url.startsWith("data:") || url.startsWith("blob:")) {
+                    return false; // contenido local: lo resuelve el propio WebView
+                }
+${o.necesitaRed
+  ? "                    // Red permitida por elección del autor de la exportación.\n                    return false;"
+  : "                    // Sin necesitaRed=true, nada de salir a la red desde el WebView.\n                    return true;"}
+            }
+        });
+
+        web.setWebChromeClient(new WebChromeClient());
+
+        if (savedInstanceState != null) {
+            web.restoreState(savedInstanceState);
+        } else {
+            web.loadUrl(ENTRADA);
+        }
+
+        setContentView(web);
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        web.saveState(outState);
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (web != null && web.canGoBack()) {
+            web.goBack();
+        } else {
+            super.onBackPressed();
+        }
+    }
+}
+`;
