import tailwindcss from '@tailwindcss/vite';
import react from '@vitejs/plugin-react';
import fs from 'fs';
import path from 'path';
import {defineConfig} from 'vite';

export default defineConfig(() => {
  return {
    plugins: [
      react(),
      tailwindcss(),
      // Guarda cerebroNodeGuard (entrada rule-modulo-puro-navegador del pack de
      // codigo): un modulo de src/ que importa fs, path, child_process o node:*
      // no puede vivir en el bundle del navegador. Se sustituye por un stub que
      // LANZA error con el modulo culpable, en vez de un "fs is not defined".
      {
        name: 'cerebroNodeGuard',
        resolveId(source: string, importer: string | undefined) {
          const esNode = source === 'fs' || source === 'path' || source === 'child_process' || source.startsWith('node:');
          if (!esNode) return null;
          // Solo codigo propio (src/), no node_modules: una dependencia puede
          // importar node:* de verdad y Vite debe resolverlo con normalidad.
          if (!importer || importer.includes('node_modules')) return null;
          return 'virtual:cerebroNodeGuard:' + source;
        },
        load(id: string) {
          if (!id.startsWith('virtual:cerebroNodeGuard:')) return null;
          const modulo = id.slice('virtual:cerebroNodeGuard:'.length);
          return `throw new Error("Un módulo de Node intentó llegar al bundle del navegador: ${modulo}. Es código del servidor; parte el módulo en lógica pura + cargador con fs en el servidor."); export default {};`;
        },
      },
      // Copies src/assets into dist/ so root-relative URLs like
      // "/src/assets/images/..." (e.g. generate_image output) still resolve
      // in production builds. Do not remove.
      {
        name: 'copy-unbundled-src-assets',
        apply: 'build',
        closeBundle(error?: Error): void {
          if (error) {
            return;
          }
          const distDir = path.resolve(__dirname, 'dist');
          const srcAssets = path.resolve(__dirname, 'src/assets');
          const distAssets = path.resolve(distDir, 'src/assets');
          if (fs.existsSync(distDir) && fs.existsSync(srcAssets)) {
            fs.cpSync(srcAssets, distAssets, {recursive: true, force: true});
          }
        },
      },
    ],
    resolve: {
      alias: {
        '@': path.resolve(__dirname, '.'),
      },
    },
    server: {
      // HMR is disabled in AI Studio via DISABLE_HMR env var.
      // Do not modify—file watching is disabled to prevent flickering during agent edits.
      hmr: process.env.DISABLE_HMR !== 'true',
      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.
      watch: process.env.DISABLE_HMR === 'true' ? null : {},
    },
  };
});
